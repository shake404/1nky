# 1NKY environment — copy to .env and fill in. NEVER commit .env.
# Rule zero: no variable here may enable request logging or IP capture.

# --- Core ---
DATABASE_URL=postgres://oneinky:oneinky@localhost:5432/oneinky
RELAY_WS_URL=ws://localhost:7777
API_PORT=3001
MEDIA_PORT=3002

# --- Media storage (S3-compatible; primary target: Cloudflare R2. $0 egress.
#     DO Spaces works with the same vars if R2 isn't set up yet — set R2_ENDPOINT.) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=1nky-media
# Optional endpoint override (e.g. https://sfo3.object-storage for DO Spaces).
# Default derives https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
MEDIA_PUBLIC_BASE=http://localhost:3002

# --- Moderation / site identity ---
# Comma-separated hex pubkeys of moderators. The site key signs board
# registries and mod lists ONLY — never user content.
SITE_MOD_PUBKEYS=
SITE_PUBKEY=

# --- Anti-spam (NIP-13 proof-of-work, bits of difficulty) ---
POW_BITS_NEW=18
POW_BITS_POST=13
POW_BITS_REACTION=8

# Shared secret for the read-only moderation endpoints (X-Mod-Key header).
# Unset = /mod/* disabled (503). Generate with: openssl rand -hex 32
MOD_API_KEY=

# Optional recovery: media service stores ONLY passphrase-locked blackbook
# ciphertext (NIP-49) keyed by pubkey. Unset keeps every /escrow route 404.
ESCROW_ENABLED=

# Best-effort offsite media redundancy: mirrors public blobs to a public
# Blossom server via BUD-04 (e.g. https://blossom.band). Unset = disabled.
BLOSSOM_MIRROR_URL=
BLOSSOM_MIRROR_CONCURRENCY=1

# --- Web client build-time vars (apps/web/.env.example mirrors these) ---
# VITE_RELAY_WS_URL / VITE_API_BASE / VITE_MEDIA_BASE point the PWA at the stack.
# VITE_POW_BITS_* MUST match POW_BITS_* below or posts silently bounce at the relay.

# --- Limits ---
MAX_UPLOAD_MB=5
NEWBIE_POSTS_PER_DAY=5
NEWBIE_WINDOW_HOURS=48
