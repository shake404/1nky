# @1nky/web — Vite build-time config. Copy to apps/web/.env.local to override.
# Every value here is baked into the bundle at build time, so nothing secret
# may ever live in this file.
#
# Defaults (in src/lib/config.ts) mirror the repo-root .env.example and work
# against a local docker-compose with no configuration at all.

# Where writes go.
VITE_RELAY_WS_URL=ws://localhost:7777

# Read-only feed/search API.
VITE_API_BASE=http://localhost:3001

# Blossom-compatible media service.
VITE_MEDIA_BASE=http://localhost:3002

# Anti-spam difficulty. Must match the relay write-policy or posts bounce.
# Mirrors POW_BITS_NEW / POW_BITS_POST / POW_BITS_REACTION at the root.
VITE_POW_BITS_NEW=18
VITE_POW_BITS_POST=13
VITE_POW_BITS_REACTION=8

# Client-side upload ceiling. Mirrors MAX_UPLOAD_MB.
VITE_MAX_UPLOAD_MB=5

# Set to 1 to reveal the diagnostics panel in Setup. Off in production.
VITE_SHOW_FLAGS=
