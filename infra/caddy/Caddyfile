# ever sees the connection. Add a `tor` service to compose whose hidden service
# forwards to caddy:8080, then mirror the routing above on a plain :8080 site.
# No TLS there — Tor already authenticates and encrypts to the hidden service.
#
# :8080 {
# 	import scrub_headers
# 	@relay path /relay /relay/*
# 	handle @relay {
# 		reverse_proxy strfry:7777
# 	}
