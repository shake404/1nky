# =============================================================================
# 1NKY — Caddyfile
# =============================================================================
#
# NO-LOGS. There is not a single `log` directive in this file and there must
# never be one. Caddy 2 does not write access logs unless a `log` block exists,
# so the absence of one IS the configuration — this is the whole no-logs
# posture from handoff Part 6/8 ("Caddy with logging disabled"). Caddy still
# writes process-level messages (startup, cert renewal, panics) to stderr; that
# is operational output about Caddy, not a record of who visited.
#
# Things that would break the promise, for the avoidance of doubt:
#   - `log { ... }` at global or site scope        -> access logs
#   - `log_credentials`                            -> worse access logs
#   - `metrics` / the admin API's /metrics         -> per-path request counters
#   - `reverse_proxy ... { header_up X-Real-IP }`  -> hands the client IP to an
#     upstream that then has to be trusted not to write it down. strfry's
#     realIpHeader is "" specifically so it cannot receive one.
#
# The origin keeps no logs regardless of what sits in front of it. See the
# commented production block at the bottom for the Cloudflare tradeoff.
# =============================================================================
{
	# No admin API. Nothing needs to reconfigure Caddy at runtime, and an open
	# localhost admin endpoint inside the container is a needless surface — it
	# also serves /metrics, which is request telemetry by another name.
	# Consequence: `caddy reload` is unavailable. Restart the container instead.
	admin off
}

# -----------------------------------------------------------------------------
# Snippets
# -----------------------------------------------------------------------------

# Strip anything that fingerprints the stack. `-Server` removes Caddy's default
# `Server: Caddy` response header (handoff Part 8: "header -Server").
(scrub_headers) {
	header {
		-Server
		-X-Powered-By
		# A flick URL must not leak to a third party via Referer.
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		# The web client has no third-party scripts, no analytics, no cookies
		# (CLAUDE.md: "Do NOT add analytics, telemetry, cookies, or
		# third-party scripts to the web client").
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}

# Content-addressed blobs are immutable by construction: the URL *is* the
# sha256 of the bytes. Handoff Part 8 — images served with
# `Cache-Control: public, max-age=31536000, immutable`.
(immutable_media) {
	header Cache-Control "public, max-age=31536000, immutable"
}

# =============================================================================
# DEV VHOST — http://localhost/
# =============================================================================
#
# A bare `:80` site address means plain HTTP with no automatic TLS, which is
# what we want locally. Bring it up with:
#     docker compose up -d postgres strfry caddy
#
# api/media live in the `full` compose profile. With only the Phase 0 three
# services running, /api/* and /media/* return 502 — that is expected, not a
# misconfiguration. /relay and / work standalone.
# =============================================================================

:80 {
	import scrub_headers

	# --- Relay websocket -----------------------------------------------------
	# Caddy 2's reverse_proxy performs the WebSocket upgrade transparently and
	# streams upgraded connections with no timeout; no special directive is
	# needed. Note the deliberate absence of any X-Forwarded-For / X-Real-IP
	# plumbing — strfry must not learn the client IP, and with
	# relay.realIpHeader = "" it would ignore one anyway.
	@relay path /relay /relay/*
	handle @relay {
		reverse_proxy strfry:7777
	}

	# --- Read-only REST API --------------------------------------------------
	# handle_path strips the matched prefix: /api/feed -> GET /feed on :3001.
	handle_path /api/* {
		reverse_proxy api:3001
	}

	# --- Blossom media service ----------------------------------------------
	# Escrow before the blob namespace: mutable record, never immutable-cached.
	handle_path /media/escrow* {
		request_body {
			max_size 16KB
		}
		header Cache-Control "no-store"
		reverse_proxy media:3002
	}

	# /media/<sha256> -> GET /<sha256> on :3002.
	handle_path /media/* {
		# Hard ceiling above MAX_UPLOAD_MB=5 so an oversized PUT is cut off at
		# the edge instead of streaming through to the re-encoder.
		request_body {
			max_size 6MB
		}
		import immutable_media
		reverse_proxy media:3002
	}

	# --- Static site placeholder --------------------------------------------
	# apps/web does not exist yet. Once it does, replace this block with the
	# root/try_files/file_server trio shown in the production section below.
	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "1NKY" 200
	}
}

# =============================================================================
# PRODUCTION — interim TLS host (ACTIVE)
# =============================================================================
# REDACTED-HOST.sslip.io resolves to the droplet's reserved IP via sslip.io's
# wildcard DNS, which lets Caddy obtain a real certificate before the 1nky.com
# nameserver flip at the registrar. The PWA on Vercel talks to this origin over
# wss:// and https://. When 1nky.com's A records resolve here, add
# `1nky.com, www.1nky.com` to the address line below and redeploy — nothing
# else changes.
# =============================================================================

api.1nky.com, REDACTED-HOST.sslip.io {
	import scrub_headers

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
	}

	# NOTE: CORS is owned by the upstream services (media and api each set
	# Access-Control-* and handle OPTIONS preflight themselves). Do NOT set CORS
	# headers here too — duplicate Access-Control-Allow-Origin values make
	# browsers reject the response ("Load failed" on Safari) and break uploads.

	@relay path /relay /relay/*
	handle @relay {
		reverse_proxy strfry:7777
	}

	handle_path /api/* {
		reverse_proxy api:3001
	}

	# Escrow before the blob namespace: mutable record, never immutable-cached.
	handle_path /media/escrow* {
		request_body {
			max_size 16KB
		}
		header Cache-Control "no-store"
		reverse_proxy media:3002
	}

	handle_path /media/* {
		request_body {
			max_size 6MB
		}
		import immutable_media
		reverse_proxy media:3002
	}

	# This host is the backend only; the PWA is served from 1nky.com (Vercel).
	handle {
		redir https://1nky.com{uri} temporary
	}
}

# =============================================================================
# PRODUCTION — 1nky.com  (COMMENTED OUT)
# =============================================================================
#
# Uncomment after infra/deploy/dns-runbook.md is done and A records resolve to
# the droplet. Then either bake apps/web's `dist/` into an image mounted at
# /srv/web, or add a `web` service to the full profile and reverse_proxy to it.
#
# Prerequisites:
#   1. A records for 1nky.com and www.1nky.com point at the droplet's reserved
#      IP (see infra/deploy/dns-runbook.md).
#   2. Ports 80 and 443 are open — cloud-init.yml opens them via UFW.
#   3. If Cloudflare proxying is ON (orange cloud), the HTTP-01 challenge will
#      fail because CF terminates TLS at the edge. Either set CF SSL mode to
#      "Full (strict)" and switch to the DNS-01 challenge with a scoped CF API
#      token (requires a Caddy build with the cloudflare DNS module), or
#      grey-cloud the record while issuing. Handoff Part 6/8 puts CF in front
#      for CDN + the free CSAM Scanning Tool; that is the later production
#      posture, not day one.
#
# -----------------------------------------------------------------------------
#
# 1nky.com, www.1nky.com {
# 	import scrub_headers
#
# 	# No `email` is configured, at global or site scope, on purpose: there is
# 	# no email anywhere in this product (handoff Part 8). Caddy will use an
# 	# anonymous ACME account.
# 	# With Cloudflare proxy ON, replace automatic issuance with DNS-01:
# 	# tls {
# 	# 	dns cloudflare {env.CF_API_TOKEN}
# 	# }
#
# 	encode zstd gzip
#
# 	header {
# 		Strict-Transport-Security "max-age=31536000; includeSubDomains"
# 		X-Frame-Options "DENY"
# 	}
#
# 	@relay path /relay /relay/*
# 	handle @relay {
# 		reverse_proxy strfry:7777
# 	}
#
# 	handle_path /api/* {
# 		reverse_proxy api:3001
# 	}
#
# 	# Immutable cache headers on /media per handoff Part 8. Content-addressed
# 	# blobs never change, so a one-year immutable TTL is safe and it is what
# 	# drives the CDN hit ratio that keeps R2 read ops at effectively zero.
# 	handle_path /media/* {
# 		request_body {
# 			max_size 6MB
# 		}
# 		import immutable_media
# 		reverse_proxy media:3002
# 	}
#
# 	# React PWA. SPA fallback so client-side routes deep-link correctly.
# 	handle {
# 		root * /srv/web
# 		try_files {path} /index.html
# 		file_server
# 		# The app shell changes on every deploy; do not let it get pinned.
# 		header /index.html Cache-Control "no-cache"
# 		# Vite emits content-hashed asset filenames, so those ARE immutable.
# 		header /assets/* Cache-Control "public, max-age=31536000, immutable"
# 	}
# }
#
# =============================================================================
# .onion MIRROR — plain :8080  (ACTIVE)
# =============================================================================
#
# The sovereign path. This vhost is reached only through the `tor` service's
# hidden service (`HiddenServicePort 80 caddy:8080` in infra/tor/torrc), which
# is on the compose network with no published host port. Nothing but this box
# and the Tor network is ever in the path: no Cloudflare, no CA, no DNS.
#
# Why there is no TLS here, and why that is not a downgrade:
#   The .onion address IS the service's public key. Tor authenticates the
#   service and encrypts end to end before this vhost sees a byte, so a
#   certificate would only add a CA to a trust path that deliberately has none.
#   Browsers treat .onion as a secure context for exactly this reason.
#
# Rules that carry over from the clearnet vhosts:
#   * NO `log` block. Same rule, no exceptions — see the header of this file.
#   * NO CORS headers. api and media each set their own and handle their own
#     preflight; a second Access-Control-Allow-Origin breaks uploads.
#   * NO HSTS. It is meaningless over plain HTTP and browsers ignore it.
#   * NO redirect to the clearnet host. A `redir https://1nky.com{uri}` here
#     would walk a Tor visitor straight out of Tor, which is the one thing this
#     vhost exists to prevent. The interim-TLS vhost above does redirect; this
#     one must not.
#
# Bring it up:  docker compose --profile full up -d --build   (then see
# infra/README.md for how to read the generated address)
# =============================================================================

:8080 {
	import scrub_headers

	# Tor bandwidth is the scarce resource on this path, so compression earns
	# more here than it does on the clearnet vhost.
	encode zstd gzip

	# --- Relay websocket -----------------------------------------------------
	# Same target, same deliberate absence of X-Forwarded-For / X-Real-IP
	# plumbing as every other vhost in this file.
	@relay path /relay /relay/*
	handle @relay {
		reverse_proxy strfry:7777
	}

	# --- Read-only REST API --------------------------------------------------
	handle_path /api/* {
		reverse_proxy api:3001
	}

	# --- Blossom media service ----------------------------------------------
	# Escrow before the blob namespace: mutable record, never immutable-cached.
	handle_path /media/escrow* {
		request_body {
			max_size 16KB
		}
		header Cache-Control "no-store"
		reverse_proxy media:3002
	}

	handle_path /media/* {
		request_body {
			max_size 6MB
		}
		import immutable_media
		reverse_proxy media:3002
	}

	# --- Root ----------------------------------------------------------------
	# apps/web's dist/ is bind-mounted read-only at /srv/web (docker-compose.yml,
	# the caddy service's `./web-dist:/srv/web:ro` volume) — same trio as the
	# commented 1nky.com block above, so this is a full mirror, not a backend
	# mirror: the onion visitor gets the PWA itself, not a placeholder, and
	# apps/web/src/lib/config.ts detects the `.onion` host at runtime and points
	# API_BASE/MEDIA_BASE/RELAY_WS_URL back at this same origin, so no separate
	# build is needed — it is the same dist/ shipped to 1nky.com.
	#
	# deploy.sh ships dist/ into ./web-dist *before* `docker compose up`
	# recreates this container, so the mount is never empty when caddy starts.
	# If you bring this vhost up by hand before a first deploy, ./web-dist is an
	# empty directory and file_server will 404 on everything except the
	# try_files fallback to /index.html, which will also 404 — that is a "dist
	# not shipped yet" state, not a config bug.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
		# The app shell changes on every deploy; do not let it get pinned.
		header /index.html Cache-Control "no-cache"
		# Vite emits content-hashed asset filenames, so those ARE immutable.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}
}
# =============================================================================
