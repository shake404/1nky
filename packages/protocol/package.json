{
  "name": "@1nky/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared 1NKY event helpers, kinds, PoW checks, blackbook (NIP-49) helpers and copy-deck constants",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "echo lint-ok",
    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "nostr-tools": "^2.10.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
