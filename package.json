{
  "name": "1nky",
  "private": true,
  "version": "0.1.0",
  "description": "1NKY — anonymous, registration-free community platform for graffiti writers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @1nky/protocol build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm -r --parallel dev"
  }
}
